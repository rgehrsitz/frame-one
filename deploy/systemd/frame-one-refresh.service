[Unit]
Description=Refresh Frame One live weather and usage dashboard
Wants=network-online.target
After=network-online.target
ConditionPathExists=/home/rgehrsitz/frame-one/.venv/bin/frame-one
ConditionPathExists=/home/rgehrsitz/.config/frame-one/dashboard.env

[Service]
Type=oneshot
User=rgehrsitz
Group=rgehrsitz
WorkingDirectory=/home/rgehrsitz/frame-one
Environment=HOME=/home/rgehrsitz
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=FRAME_ONE_ROOT=/home/rgehrsitz/frame-one
Environment=FRAME_ONE_CONFIG_DIR=/home/rgehrsitz/.config/frame-one
EnvironmentFile=/home/rgehrsitz/.config/frame-one/dashboard.env
TimeoutStartSec=3min
ExecStart=/usr/bin/flock -n -E 0 /home/rgehrsitz/.config/frame-one/refresh.lock /home/rgehrsitz/frame-one/scripts/refresh-dashboard.sh

[Install]
WantedBy=multi-user.target
